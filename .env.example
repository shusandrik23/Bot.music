# Telegram: @BotFather -> /newbot
BOT_TOKEN=123456789:AA...

# Spotify: https://developer.spotify.com/dashboard -> Create App (Web API)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: model override
GEMINI_MODEL=gemini-3.8-flash

# Offset from UTC in hours for the daily digest schedule (3 = Moscow)
TIMEZONE_OFFSET=3

# Optional: SQLite file path
DB_PATH=bot_data.db

# Spotify login for playlist features (create / analyze your playlists).
# Must be EXACTLY the same as a Redirect URI added in the Spotify app settings.
# Render: https://your-bot.onrender.com/spotify/callback
# Local:  http://127.0.0.1:8080/spotify/callback
SPOTIFY_REDIRECT_URI=

# Optional: public URL the bot pings every 10 min so free hosting doesn't put it to sleep.
# On Render it is detected automatically (RENDER_EXTERNAL_URL), so leave it empty there.
KEEPALIVE_URL=

# Optional: menu buttons, comma-separated (empty = built-in lists). Example:
# GENRES=Рок,Поп,Хип-хоп,Электроника,Инди,Метал
GENRES=
ERAS=
HITS=
REFS=
LANGS=
HIST=
FILMS=
GAMES=

# Optional: Spotify markets (country codes, comma-separated, tried in order) for podcast search
SPOTIFY_MARKETS=US,DE,KZ
